+# Install a relocatable C++ package for downstream consumers.
+include(CMakePackageConfigHelpers)
+set_target_properties(libplaco PROPERTIES EXPORT_NAME placo)
+target_compile_features(libplaco PUBLIC cxx_std_17)
+add_library(placo::placo ALIAS libplaco)
+install(TARGETS libplaco EXPORT placoTargets
+  LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+  ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+  RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
+install(DIRECTORY src/placo DESTINATION include FILES_MATCHING PATTERN "*.h" PATTERN "*.hpp")
+install(DIRECTORY thirdparty/qpmad/include/qpmad DESTINATION include)
+install(FILES LICENSE DESTINATION share/placo)
+install(FILES thirdparty/qpmad/LICENSE thirdparty/qpmad/NOTICE DESTINATION share/placo/qpmad)
+install(EXPORT placoTargets NAMESPACE placo:: DESTINATION lib/cmake/placo)
+file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/placoConfig.cmake.in" [=[
+@PACKAGE_INIT@
+include(CMakeFindDependencyMacro)
+find_dependency(Threads)
+find_dependency(Eigen3 3 REQUIRED NO_MODULE)
+find_dependency(pinocchio)
+find_dependency(jsoncpp)
+include("${CMAKE_CURRENT_LIST_DIR}/placoTargets.cmake")
+]=])
+configure_package_config_file("${CMAKE_CURRENT_BINARY_DIR}/placoConfig.cmake.in"
+  "${CMAKE_CURRENT_BINARY_DIR}/placoConfig.cmake" INSTALL_DESTINATION lib/cmake/placo)
+install(FILES "${CMAKE_CURRENT_BINARY_DIR}/placoConfig.cmake" DESTINATION lib/cmake/placo)
